# Placeholders only. Copy to .env (gitignored) and fill in. Never commit real values.

# ERC-20 used for stakes. Arc testnet USDC (6 decimals via the ERC-20 interface):
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Address allowed to create, resolve and void challenges (the backend operator). Address only, not a key.
RESOLVER_ADDRESS=0x0000000000000000000000000000000000000000

# Arc testnet RPC (chain ID 5042002)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# The deployer key is NOT stored here. Pass it at deploy time through a Foundry keystore
# (`cast wallet import`) and `--account <name>`. Testnet keys only.
