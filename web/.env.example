# Base URL of the Rust backend API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# --- Backend running with AEN_API_TOKEN (SEC-02, D-70) ---
# The browser must never hold the token, so route calls through this web server instead:
#   NEXT_PUBLIC_API_URL=/backend   (rebuild after changing; NEXT_PUBLIC_* is inlined at build time)
# and give the web server (server-only, never NEXT_PUBLIC_) the backend URL and token:
# AEN_API_URL=http://localhost:8080/api
# AEN_API_TOKEN=
# Extra Host names the proxy serves besides localhost/127.0.0.1/[::1] (comma separated):
# WEB_ALLOWED_HOSTS=
