# Copy to .env and adjust. Never commit a real .env. No secrets are needed for M1.

# Local Postgres. Put your OS user before the @ (no password on a default local install).
DATABASE_URL=postgres://YOUR_OS_USER@localhost/aen_dev

# Optional.
PORT=8080
CORS_ORIGIN=http://localhost:3000

# Integration tests default to postgres://$USER@localhost/aen_test.
# TEST_DATABASE_URL=postgres://YOUR_OS_USER@localhost/aen_test
