# Copy to .env and adjust. Never commit a real .env. No secrets are needed for M1.

# Local Postgres. Put your OS user before the @ (no password on a default local install).
DATABASE_URL=postgres://YOUR_OS_USER@localhost/aen_dev

# Optional.
PORT=8080
CORS_ORIGIN=http://localhost:3000

# Integration tests default to postgres://$USER@localhost/aen_test.
# TEST_DATABASE_URL=postgres://YOUR_OS_USER@localhost/aen_test

# --- M2: challenge lifecycle (simulated funds only) ---
# Market data: `gemini` = the Gemini crypto exchange's public API (no key needed),
# `fake` = deterministic in-memory market (offline demos; enables /api/dev/fake-market
# and the simulated clock on /api/dev/tick).
# MARKET_DATA=gemini
# GEMINI_BASE_URL=https://api.gemini.com
# Seconds between automatic lifecycle ticks; 0 disables the scheduler.
# TICK_INTERVAL_SECS=15
# Offers allowed per negotiation, counting the proposal.
# MAX_NEGOTIATION_ROUNDS=3
# Seconds a proposal leaves for both stakes to be committed.
# FUNDING_WINDOW_SECS=300
# Seconds after end_ts to keep retrying market data before voiding and refunding.
# RESOLUTION_GRACE_SECS=600
# Seconds before an agent may propose again on a market it already proposed on (0 = off).
# PROPOSAL_COOLDOWN_SECS=600
# Market looked at by schedule-triggered agents.
# DEFAULT_SYMBOL=BTCUSD
# Set to false to unmount /api/dev/*.
# DEV_ENDPOINTS=true

# Optional: agent reasoning through xAI Grok. Without a key the deterministic
# rule-based reasoner is used; with a key, Grok is used and the rules remain the
# fallback on any error. Never commit a real key.
# XAI_API_KEY=
# XAI_MODEL=grok-4.7
# XAI_BASE_URL=https://api.x.ai/v1

# --- SEC-02: request guard (always on: Host allowlist + Origin check) ---
# Address to listen on. Anything but loopback requires AEN_API_TOKEN.
# BIND_ADDR=127.0.0.1
# Bearer token (>= 32 chars). When set, every request except GET /api/health
# needs `Authorization: Bearer <token>`. Leave unset for the local web app.
# AEN_API_TOKEN=
# Extra Host names to serve (comma-separated); localhost, 127.0.0.1, [::1] always are.
# ALLOWED_HOSTS=

# --- QuickNode Streams webhook (local ingestion only; route mounted only when the secret is set) ---
# The stream's security token. Header names and signed-message layout are UNVERIFIED (docs/api.md).
# QUICKNODE_STREAMS_SECRET=
# QUICKNODE_SIGNATURE_HEADER=x-qn-signature
# QUICKNODE_TIMESTAMP_HEADER=x-qn-timestamp
# QUICKNODE_NONCE_HEADER=x-qn-nonce
# QUICKNODE_MAX_SKEW_SECS=300
# Behind a tunnel, add its host to ALLOWED_HOSTS; that makes AEN_API_TOKEN required.

# Arc testnet deployment (D-60), addresses only
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_ESCROW_ADDRESS=0x4179f2e314410D10C2906B1914bAAe8DD93b5698
ARC_VAULT_FACTORY_ADDRESS=0x4EA6ac6A9F7b8fcf01ba04b177F0A098d9664C45
